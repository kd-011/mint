# Copy to .env next to server.mjs (chmod 600). Placeholders only, never real values.
# Lines starting with # are optional settings shown with their defaults.

# ---- Required ---------------------------------------------------------------

# The shared secret your login gateway sends to Mint as the X-Mint-Gate header (32+
# characters, for example `openssl rand -hex 32`). Mint refuses every request that does
# not carry it, so set it here and in your reverse proxy.
MINT_GATE_KEY=

# The login name your gateway sends as Remote-User. Only this user is let in.
MINT_USER=owner

# The https origin you serve Mint from, no trailing slash. The fingerprint lock is bound
# to its host name. Unset, it is http://localhost:<port>, which is right for a trial.
MINT_ORIGIN=https://mint.example.com

# ---- Server -----------------------------------------------------------------

# MINT_PORT=8970            Listens on 127.0.0.1 only unless MINT_HOST says otherwise.
# MINT_HOST=127.0.0.1       Bind address. Leave it. The Docker image sets 0.0.0.0 inside the container only.
# MINT_HOME=                Where data/, backups/ and this .env live. Default: the folder holding server.mjs.
# MINT_SCHEDULER=off        Turns the 30 minute poll and the nightly reconcile off (tests, trials).
# MINT_TZ=Australia/Perth   Your timezone, an IANA name such as Australia/Sydney or Australia/Adelaide. Days, pay
#                           cycles, the financial year and the 02:40 nightly run all follow it, daylight saving included.
#                           Set it before the first sync: changing it later only re-buckets days from then on. Unknown names stop the start.

# Fingerprint lock (passkey, on by default). MINT_LOCK=off is refused once a fingerprint
# has been enrolled; run scripts/lock-reset.mjs --yes --disable first.
# MINT_LOCK=off
# Tests and throwaway checks only: an extra http://localhost:<port> origin with rp id localhost.
# MINT_LOCK_DEV_ORIGIN=

# ---- Bank feed (Redbark), optional ------------------------------------------

# Your Redbark API key (https://redbark.com, a paid service, see docs/redbark-setup.md).
# Unset, Mint runs without a bank feed: you add accounts by hand and import CSV
# statements (docs/csv-import.md), and the 30 minute poll and nightly reconcile stay off.
# REDBARK_API_KEY=rbk_live_xxx

# Signing secret of a Redbark webhook destination (X-Redbark-Signature). Comma-separate two
# during rotation. Without a webhook Mint polls every 30 minutes, which is fine.
REDBARK_WEBHOOK_SECRET=
# Signing secret of a v2 event destination (Redbark-Signature t=,v1=). Same rotation rule.
REDBARK_EVENTS_SECRET=
# REDBARK_API_BASE=         Override the Redbark API address (tests use a fake one).

# ---- Optional: merchant categorising with a language model -------------------

# An OpenRouter key (https://openrouter.ai). Unset, unknown merchants stay uncategorised
# until you pick a category or a rule matches. Only the merchant text is sent, never amounts or account numbers.
OPENROUTER_API_KEY=
# MINT_AI_MODEL=google/gemini-3.1-flash-lite
# MINT_AI_DAILY_CAP=1500
# MINT_AI_BASE=https://openrouter.ai/api/v1

# ---- Optional: other data sources -------------------------------------------

# Wise personal API token (read-only: balances and statements). Unset = no Wise sync.
# Sent only to https://api.wise.com.
WISE_API_TOKEN=
# Free Alpha Vantage key for live US share prices (alphavantage.co). Unset means manual prices.
# ASX prices come from Yahoo without a key.
ALPHAVANTAGE_API_KEY=
# MINT_QUOTE_DAILY_CAP=25
# MINT_FX_BASE=             Override the Frankfurter exchange-rate API address.
# ALPHAVANTAGE_BASE=
# YAHOO_CHART_BASE=

# ---- Optional: Assistant chat (maintainer's private assistant, off unless set) --------
# These two lines connect Mint to an assistant server, a private AI assistant that is not
# part of this project. Leave them unset and the chat button, the Ask tile and the
# /api/chat route are all off. Nothing else in Mint needs it.

# The key Mint uses to call the assistant (32+ characters, same value on both sides).
MINT_CHAT_KEY=
# Where the assistant listens (loopback http only).
# MINT_CHAT_URL=http://127.0.0.1:3000
# The key the assistant uses to call Mint's /api/assistant/ door (32+ characters). Unset = the door is shut.
MINT_API_KEY=

# ---- Backups ------------------------------------------------------------------

# age public key (age1...) the off-box backup is encrypted to. Generate a pair with
# `age-keygen`; keep the private key OFF this machine's repo folder (for example
# ~/.secrets/mint-backup-age.key). Without it scripts/backup.mjs makes no off-box copy.
MINT_BACKUP_AGE_RECIPIENT=
# ssh host name (as in ~/.ssh/config) and folder that receive the encrypted copy. Unset = local snapshot only.
MINT_BACKUP_HOST=
# MINT_BACKUP_DIR=mint-backups
# Private key for scripts/restore-test.mjs. Default: ~/.secrets/mint-backup-age.key
# MINT_BACKUP_AGE_KEY=
# Opt in to a startup preflight (scripts/check-env.mjs) that fails, naming the variables, when
# off-box backup settings are missing or malformed. Off unless set.
# MINT_REQUIRE_OFFBOX=1

# ---- Optional: Android app (android-shell/, bring your own keystore) -------------

# SHA-256 of the certificate you sign the app with, as keytool prints it (aa:bb:...), and the
# app's package id if you renamed it. Unset = the web app works and the Android app is not recognised.
# MINT_ANDROID_CERT_SHA256=
# MINT_ANDROID_PACKAGE=io.github.kd011.mint
# Opt in to the same preflight for the Android certificate: fail if MINT_ANDROID_CERT_SHA256 is missing or malformed.
# MINT_REQUIRE_ANDROID=1
