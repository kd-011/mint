# Build settings for the Mint Android shell. Copy to shell.env (gitignored) in
# this folder, or to ~/.config/mint/android.env, or point MINT_ANDROID_ENV at
# any file. build.sh and publish.sh use the first one found, in that order of
# precedence: $MINT_ANDROID_ENV, ./shell.env, ~/.config/mint/android.env.

# Required. Public https origin of your Mint server, with or without a trailing slash.
MINT_APP_ORIGIN=https://mint.example.com/

# Optional. Host of the login gateway your reverse proxy redirects to
# (Authelia, Authentik, Cloudflare Access, ...). Leave empty if there is none.
# The app keeps sign-in inside the WebView only for this host and the app host.
MINT_AUTH_HOST=auth.example.com

# JDK 21 home. Optional if `java` on PATH is already JDK 21.
JAVA_HOME=/path/to/jdk-21

# Required. Android SDK root (needs platform 36 and build-tools 35.0.0).
ANDROID_HOME=/path/to/android-sdk

# Optional. Directory holding `node` and `npm`, if they are not already on PATH.
# NODE_BIN_DIR=/path/to/node/bin

# Optional. Only for publish.sh: ssh host and directory the APK is copied to.
PUBLISH_HOST=files.example.com
PUBLISH_DIR=/srv/apps
